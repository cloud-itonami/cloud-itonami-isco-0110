{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}
io.github.kotoba-lang/langgraph
        {:git/sha "5b4e5e70837b849b14b6a5800894e3be202ad5fa"}
        ;; langchain-store: the shared langchain.db store seam (EDN-blob
        ;; codec + identity schema + event-log helpers) that ~190
        ;; cloud-itonami actors hand-roll (ADR-2607141600);
        ;; officer-admin.store's DatomicStore uses it instead of its own
        ;; enc/dec* two-liner. :local/root resolves inside the monorepo
        ;; checkout — a standalone fork should override it with git
        ;; coordinates.
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  :test {:extra-paths ["test"]
         ;; amu is TEST-ONLY, for the governor parity gate: it compiles
         ;; `src/officer_admin/governor_core.kotoba` and runs it against
         ;; `governor/check`. Nothing at runtime compiles.
         :extra-deps {io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "f5cf064366591ea729441b41143cc99e18e8239a"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :render-html {:main-opts ["-m" "officer-admin.render-html"]}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                         "--lint" "src" "test"
                         "--fail-level" "error"]}}}
